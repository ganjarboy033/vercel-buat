# ===== Wajib =====
# Kunci yang harus dikirim aplikasi pada header x-nexora-key (min. 32 karakter acak).
NEXORA_API_KEY=
# Rahasia untuk mengenkripsi tiket/kode/state (min. 32 karakter acak). JANGAN diganti setelah dipakai, atau semua tiket lama tidak berlaku.
BRIDGE_SECRET=
# URL publik deployment, tanpa garis miring akhir. Contoh: https://nexora-link.vercel.app
PUBLIC_BASE_URL=

# ===== Deep link kembali ke aplikasi (default sudah sesuai APK) =====
APP_REDIRECT_URI=nexoracloud://link

# ===== Google (Drive & Photos) — opsional =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: daftar scope bawaan dipisah koma (alias: drive, drive_file, photos_upload, photos_picker, photos_appdata)
GOOGLE_DEFAULT_SCOPES=drive_file,photos_upload,photos_picker

# ===== GitHub OAuth App — opsional (aplikasi juga mendukung Personal Access Token langsung) =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_DEFAULT_SCOPE=repo

# ===== Telegram Bot API proxy — opsional =====
TELEGRAM_BOT_TOKEN=
# Metode yang diizinkan, dipisah koma.
ALLOWED_TELEGRAM_METHODS=getMe,getChat,getChatMember,getFile,sendMessage,sendDocument,copyMessage,forwardMessage,deleteMessage,editMessageCaption

# ===== Pembatasan =====
RATE_LIMIT_PER_MINUTE=60
TICKET_TTL_DAYS=180
